-- ระบบกดคลิกปกติ VS กดค้าง 3-4 วินาที
local holdTimer = 0
local isHolding = false
local holdDuration = 3.5

CatButton.MouseButton1Down:Connect(function()
    isHolding = true
    holdTimer = 0
    task.spawn(function()
        while isHolding do
            holdTimer = holdTimer + 0.1
            if holdTimer >= holdDuration then
                isHolding = false
                SettingsFrame.Visible = true
                MainFrame.Visible = false
                break
            end
            task.wait(0.1)
        end
    end)
end)

CatButton.MouseButton1Up:Connect(function()
    if isHolding then
        isHolding = false
        if holdTimer < holdDuration then
            MainFrame.Visible = not MainFrame.Visible
            SettingsFrame.Visible = false
        end
    end
end)

